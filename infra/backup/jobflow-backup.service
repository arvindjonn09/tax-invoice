# Nightly encrypted JobFlow backup (#63). Install with jobflow-backup.timer.
[Unit]
Description=JobFlow encrypted backup (database + documents)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=jobflow-backup
WorkingDirectory=/srv/jobflow
# DATABASE_URL (a read-only backup role), S3_* and APP_ENV.
EnvironmentFile=/etc/jobflow/backup.env
# BACKUP_ENCRYPTION_KEY only; root-owned 0400, kept apart from the backups.
EnvironmentFile=/etc/jobflow/backup-key.env
ExecStart=/srv/jobflow/infra/backup/run-backup.sh
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/var/backups/jobflow
