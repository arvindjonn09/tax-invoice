# Copy to web.env (never commit it). The RUNTIME connection: jobflow_web, a member of jobflow_app.
APP_ENV=staging
DATABASE_URL=postgresql://jobflow_web:replace-with-a-different-32-random-characters@postgres:5432/jobflow
# Public https origin. Its scheme makes cookies Secure and turns on HSTS.
BETTER_AUTH_URL=https://staging.jobflow.example
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# Private, encrypted, non-public bucket in ap-southeast-2; a key scoped to this bucket only.
S3_REGION=ap-southeast-2
S3_BUCKET=jobflow-staging-documents
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
# S3_ENDPOINT=https://s3.ap-southeast-2.amazonaws.com
