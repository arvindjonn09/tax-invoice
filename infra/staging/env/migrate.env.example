# Copy to migrate.env (never commit it). The OWNER connection, used only by the migrate job.
APP_ENV=staging
DATABASE_URL=postgresql://jobflow_owner:replace-with-32-random-characters@postgres:5432/jobflow
# Creates/updates the jobflow_web LOGIN role (24+ characters). Same value as in web.env.
RUNTIME_DATABASE_PASSWORD=replace-with-a-different-32-random-characters
# Creates/updates the read-only jobflow_backup role (24+ characters). Same value as in backup.env.
BACKUP_DATABASE_PASSWORD=replace-with-a-third-random-hex-password

# Optional maintenance login; same password as maintenance.env (#170).
MAINTENANCE_DATABASE_PASSWORD=replace-with-another-32-random-characters
