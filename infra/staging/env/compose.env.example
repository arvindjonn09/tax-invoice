# Copy to compose.env. Used by `docker compose --env-file` for the certbot command.
JOBFLOW_DOMAIN=staging.jobflow.example
ACME_EMAIL=ops@jobflow.example
# #136: the ClamAV image, pinned by digest. Get the digest on the host with:
#   docker buildx imagetools inspect clamav/clamav:1.4 --format '{{json .Manifest.Digest}}'
# The deploy gate refuses a value that isn't clamav/clamav:<tag>@sha256:<64 hex>.
CLAMAV_IMAGE=clamav/clamav:1.4@sha256:replace-with-the-digest
