# Copy to backup.env (never commit it). The nightly backup (#173).
APP_ENV=staging
# The read-only jobflow_backup role (pg_read_all_data), created by the migrate
# job from BACKUP_DATABASE_PASSWORD in migrate.env. Never the owner or web role.
DATABASE_URL=postgresql://jobflow_backup:replace-with-a-third-random-hex-password@postgres:5432/jobflow
# Document storage: a key that can only read the documents bucket.
S3_REGION=ap-southeast-2
S3_BUCKET=jobflow-staging-documents
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
# Off-site copy: a bucket in another account, with versioning and object lock.
# BACKUP_OFFSITE_S3_URI=s3://jobflow-staging-backups-offsite
# AWS_ACCESS_KEY_ID=replace-me
# AWS_SECRET_ACCESS_KEY=replace-me
