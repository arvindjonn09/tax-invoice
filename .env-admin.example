# Owner admin console (#252) at /admin-console. Copy to `.env-admin` next to
# `.env` (gitignored) and fill in. The file is re-read on every login, so
# changes apply without a restart. The console is off (404) until the
# username, a 12+ character password and a 32+ character secret are set.
ADMIN_CONSOLE_USERNAME=
ADMIN_CONSOLE_PASSWORD=
# Signs the console session cookie. Changing it signs everyone out.
ADMIN_CONSOLE_SECRET=replace-with-at-least-32-random-characters
# Optional: the shared Claude/Codex updates page shown on the GitHub tab.
AGENT_UPDATES_FILE=
