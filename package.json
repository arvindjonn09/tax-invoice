{
  "name": "jobflow",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @jobflow/web dev",
    "build": "pnpm --filter @jobflow/web build",
    "typecheck": "pnpm db:generate && node scripts/check-strict.mjs && tsc --noEmit && pnpm -r typecheck",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:integration": "node scripts/database/test-runner.mjs",
    "test:e2e": "playwright test",
    "audit:prod": "node scripts/audit-production.mjs",
    "db:env": "node scripts/database/create-local-env.mjs",
    "db:generate": "node scripts/database/cli.mjs generate",
    "db:validate": "node scripts/database/cli.mjs validate",
    "db:migrate": "node scripts/database/cli.mjs migrate deploy",
    "db:migrate:dev": "node scripts/database/cli.mjs migrate dev",
    "db:test:reset": "node scripts/database/reset-test.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.19.0",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.2",
    "prettier": "^3.6.2",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "type": "module",
  "pnpm": {
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-vfj7-8cjw-p6xm"
      ]
    }
  }
}
