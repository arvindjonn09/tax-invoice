/// A private file (#34). Bytes live in S3-compatible storage under a random
/// key; reached only through an authorised, short-lived signed link.
model Document {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String       @map("company_id") @db.Uuid
  kind        DocumentKind
  objectKey   String       @unique @map("object_key") @db.VarChar(200)
  fileName    String       @map("file_name") @db.VarChar(200)
  contentType String       @map("content_type") @db.VarChar(100)
  sizeBytes   Int          @map("size_bytes")
  sha256      String       @db.Char(64)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy   String       @map("created_by") @db.Uuid
  company     Company      @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  creator     Membership   @relation(fields: [companyId, createdBy], references: [companyId, userId], onDelete: NoAction, onUpdate: NoAction)
  expense     Expense?

  workEvidence WorkEvidence?

  supplierBill SupplierBill?

  @@unique([companyId, id])
  @@index([companyId, createdBy])
  @@map("documents")
}

enum TimesheetStatus {
  submitted
  approved
  rejected

  @@map("timesheet_status")
}

/// Effective-dated internal cost rate (#38). Append-only (SQL trigger).
model EmployeeRate {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId       String      @map("company_id") @db.Uuid
  employeeId      String      @map("employee_id") @db.Uuid
  effectiveFrom   DateTime    @map("effective_from") @db.Date
  hourlyCostCents BigInt      @map("hourly_cost_cents")
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy       String      @map("created_by") @db.Uuid
  employee        Employee    @relation(fields: [companyId, employeeId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)
  creator         Membership  @relation("EmployeeRateCreator", fields: [companyId, createdBy], references: [companyId, userId], onDelete: NoAction, onUpdate: NoAction)
  timesheets      Timesheet[]

  @@unique([companyId, id])
  @@unique([companyId, employeeId, effectiveFrom], map: "employee_rate_history_employee_from_key")
  @@index([companyId, createdBy])
  @@map("employee_rate_history")
}

/// Time on a job or visit (#38). Cost is incurred once, on approval, from the
/// snapshot; a SQL trigger freezes decided timesheets and a correction is an
/// approved reversal (reversesId) with negated minutes and cost.
model Timesheet {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId       String          @map("company_id") @db.Uuid
  employeeId      String          @map("employee_id") @db.Uuid
  jobId           String          @map("job_id") @db.Uuid
  visitId         String?         @map("visit_id") @db.Uuid
  workDate        DateTime        @map("work_date") @db.Date
  minutes         Int
  note            String?         @db.VarChar(500)
  status          TimesheetStatus @default(submitted)
  decisionNote    String?         @map("decision_note") @db.VarChar(500)
  decidedAt       DateTime?       @map("decided_at") @db.Timestamptz(3)
  decidedBy       String?         @map("decided_by") @db.Uuid
  rateId          String?         @map("rate_id") @db.Uuid
  hourlyCostCents BigInt?         @map("hourly_cost_cents")
  costCents       BigInt?         @map("cost_cents")
  reversesId      String?         @map("reverses_id") @db.Uuid
  submittedBy     String          @map("submitted_by") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  employee        Employee        @relation(fields: [companyId, employeeId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)
  job             Job             @relation(fields: [companyId, jobId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)
  visit           JobVisit?       @relation(fields: [companyId, jobId, visitId], references: [companyId, jobId, id], onDelete: NoAction, onUpdate: NoAction)
  rate            EmployeeRate?   @relation(fields: [companyId, rateId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)
  reverses        Timesheet?      @relation("TimesheetReversal", fields: [companyId, reversesId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)
  reversedBy      Timesheet?      @relation("TimesheetReversal")
  submitter       Membership      @relation("TimesheetSubmitter", fields: [companyId, submittedBy], references: [companyId, userId], onDelete: NoAction, onUpdate: NoAction)
  decider         Membership?     @relation("TimesheetDecider", fields: [companyId, decidedBy], references: [companyId, userId], onDelete: NoAction, onUpdate: NoAction)

  @@unique([companyId, id])
  @@unique([companyId, reversesId])
  @@index([companyId, jobId])
  @@index([companyId, employeeId, workDate])
  @@index([companyId, status])
  @@index([companyId, submittedBy])
  @@index([companyId, decidedBy])
  @@index([companyId, rateId])
  @@map("timesheets")
}

