/// A job or general expense (#40). Cost is incurred once, on approval, from
/// the snapshot columns; a SQL trigger freezes decided expenses and a
/// correction is an approved reversal (reversesId) with negated cents.
model Expense {
  id                    String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId             String             @map("company_id") @db.Uuid
  jobId                 String?            @map("job_id") @db.Uuid
  category              ExpenseCategory
  description           String             @db.VarChar(500)
  supplierName          String?            @map("supplier_name") @db.VarChar(200)
  purchasedOn           DateTime           @map("purchased_on") @db.Date
  priceEntry            PriceEntry         @map("price_entry")
  enteredAmountCents    BigInt             @map("entered_amount_cents")
  taxCode               TaxCode            @map("tax_code")
  gstRateBasisPoints    Int                @map("gst_rate_basis_points")
  exclusiveCents        BigInt             @map("exclusive_cents")
  gstCents              BigInt             @map("gst_cents")
  inclusiveCents        BigInt             @map("inclusive_cents")
  creditableBasisPoints Int                @default(10000) @map("creditable_basis_points")
  receiptDocumentId     String?            @map("receipt_document_id") @db.Uuid
  settlement            ExpenseSettlement?
  paidOn                DateTime?          @map("paid_on") @db.Date
  paymentMethod         PaymentMethod?     @map("payment_method")
  status                ExpenseStatus      @default(submitted)
  decisionNote          String?            @map("decision_note") @db.VarChar(500)
  decidedAt             DateTime?          @map("decided_at") @db.Timestamptz(3)
  decidedBy             String?            @map("decided_by") @db.Uuid
  companyGstRegistered  Boolean?           @map("company_gst_registered")
  evidenceVerified      Boolean?           @map("evidence_verified")
  hasEvidence           Boolean?           @map("has_evidence")
  creditableGstCents    BigInt?            @map("creditable_gst_cents")
  nonCreditableGstCents BigInt?            @map("non_creditable_gst_cents")
  jobCostCents          BigInt?            @map("job_cost_cents")
  reversesId            String?            @map("reverses_id") @db.Uuid
  /// A correction of a cost-only-reversed expense; reuses its settlement.
  correctsId            String?            @map("corrects_id") @db.Uuid
  submittedBy           String             @map("submitted_by") @db.Uuid
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  company               Company            @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  job                   Job?               @relation(fields: [companyId, jobId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)
  receipt               Document?          @relation(fields: [companyId, receiptDocumentId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)
  reverses              Expense?           @relation("ExpenseReversal", fields: [companyId, reversesId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)
  reversedBy            Expense?           @relation("ExpenseReversal")
  corrects              Expense?           @relation("ExpenseCorrection", fields: [companyId, correctsId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)
  /// Corrections of this expense: at most one live (submitted/approved);
  /// rejected ones are kept (partial unique index in the migration).
  corrections           Expense[]          @relation("ExpenseCorrection")
  submitter             Membership         @relation("ExpenseSubmitter", fields: [companyId, submittedBy], references: [companyId, userId], onDelete: NoAction, onUpdate: NoAction)
  decider               Membership?        @relation("ExpenseDecider", fields: [companyId, decidedBy], references: [companyId, userId], onDelete: NoAction, onUpdate: NoAction)

  @@unique([companyId, id])
  @@unique([companyId, receiptDocumentId])
  @@unique([companyId, reversesId])
  @@index([companyId, correctsId])
  @@index([companyId, jobId])
  @@index([companyId, status, purchasedOn])
  @@index([companyId, submittedBy])
  @@index([companyId, decidedBy])
  @@map("expenses")
}

enum WorkEvidenceKind {
  photo
  note
  signature

  @@map("work_evidence_kind")
}

/// Proof of work from the workers on a job (#42): photos, notes, customer
/// signatures. Append-only (trigger); files are private documents (#34).
model WorkEvidence {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String           @map("company_id") @db.Uuid
  jobId       String           @map("job_id") @db.Uuid
  visitId     String?          @map("visit_id") @db.Uuid
  kind        WorkEvidenceKind
  documentId  String?          @map("document_id") @db.Uuid
  note        String?          @db.VarChar(2000)
  submittedBy String           @map("submitted_by") @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  job         Job              @relation(fields: [companyId, jobId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)
  visit       JobVisit?        @relation(fields: [companyId, jobId, visitId], references: [companyId, jobId, id], onDelete: NoAction, onUpdate: NoAction)
  document    Document?        @relation(fields: [companyId, documentId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)
  submitter   Membership       @relation(fields: [companyId, submittedBy], references: [companyId, userId], onDelete: NoAction, onUpdate: NoAction)

  @@unique([companyId, documentId])
  @@index([companyId, jobId, createdAt])
  @@index([companyId, submittedBy])
  @@map("work_evidence")
}

/// Supplier or contractor bill (#46). Keeps the supplier's own line figures
/// (R3) and snapshots creditable GST, non-creditable GST and job cost once.
/// Immutable except a one-way void (DB trigger). Checks in SQL.
model SupplierBill {
  id                    String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId             String                      @map("company_id") @db.Uuid
  jobId                 String?                     @map("job_id") @db.Uuid
  contractorId          String?                     @map("contractor_id") @db.Uuid
  /// The accepted offer this bill fulfils (releases its commitment).
  offerId               String?                     @map("offer_id") @db.Uuid
  supplierName          String                      @map("supplier_name") @db.VarChar(200)
  supplierAbn           String?                     @map("supplier_abn") @db.Char(11)
  supplierGstRegistered Boolean                     @map("supplier_gst_registered")
  /// One live bill per supplier reference (case-insensitive; partial unique
  /// indexes supplier_bills_live_*_reference_key in the migration).
  supplierReference     String?                     @map("supplier_reference") @db.VarChar(100)
  issuedOn              DateTime                    @map("issued_on") @db.Date
  dueOn                 DateTime?                   @map("due_on") @db.Date
  documentId            String?                     @map("document_id") @db.Uuid
  evidenceVerified      Boolean                     @default(false) @map("evidence_verified")
  hasEvidence           Boolean                     @map("has_evidence")
  creditableBasisPoints Int                         @default(10000) @map("creditable_basis_points")
  creditableReason      String?                     @map("creditable_reason") @db.VarChar(500)
  companyGstRegistered  Boolean                     @map("company_gst_registered")
  exclusiveCents        BigInt                      @map("exclusive_cents")
  gstCents              BigInt                      @map("gst_cents")
  inclusiveCents        BigInt                      @map("inclusive_cents")
  creditableGstCents    BigInt                      @map("creditable_gst_cents")
  nonCreditableGstCents BigInt                      @map("non_creditable_gst_cents")
  jobCostCents          BigInt                      @map("job_cost_cents")
  note                  String?                     @db.VarChar(500)
  voidReason            String?                     @map("void_reason") @db.VarChar(500)
  voidedAt              DateTime?                   @map("voided_at") @db.Timestamptz(3)
  voidedBy              String?                     @map("voided_by") @db.Uuid
  createdAt             DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy             String                      @map("created_by") @db.Uuid
  company               Company                     @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  job                   Job?                        @relation(fields: [companyId, jobId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)
  contractor            Contractor?                 @relation(fields: [companyId, contractorId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)
  acceptance            ContractorAcceptance?       @relation(fields: [companyId, offerId, jobId, contractorId], references: [companyId, offerId, jobId, contractorId], onDelete: NoAction, onUpdate: NoAction, map: "supplier_bills_acceptance_fkey")
  document              Document?                   @relation(fields: [companyId, documentId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)
  creator               Membership                  @relation("BillCreator", fields: [companyId, createdBy], references: [companyId, userId], onDelete: NoAction, onUpdate: NoAction)
  voider                Membership?                 @relation("BillVoider", fields: [companyId, voidedBy], references: [companyId, userId], onDelete: NoAction, onUpdate: NoAction)
  items                 SupplierBillItem[]
  allocations           SupplierPaymentAllocation[]

  @@unique([companyId, id])
  @@unique([companyId, documentId])
  @@index([companyId, jobId])
  @@index([companyId, contractorId])
  @@index([companyId, offerId])
  @@index([companyId, issuedOn])
  @@index([companyId, createdBy])
  @@map("supplier_bills")
}

/// A bill line as the supplier issued it; append-only.
model SupplierBillItem {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId          String       @map("company_id") @db.Uuid
  billId             String       @map("bill_id") @db.Uuid
  position           Int
  description        String       @db.VarChar(500)
  taxCode            TaxCode      @map("tax_code")
  gstRateBasisPoints Int          @map("gst_rate_basis_points")
  exclusiveCents     BigInt       @map("exclusive_cents")
  gstCents           BigInt       @map("gst_cents")
  inclusiveCents     BigInt       @map("inclusive_cents")
  bill               SupplierBill @relation(fields: [companyId, billId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([billId, position])
  @@index([companyId, billId])
  @@map("supplier_bill_items")
}

/// Money paid to a supplier, allocated to bills (#46). Idempotent by
/// (company, idempotencyKey); immutable except a one-way void.
model SupplierPayment {
  id             String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId      String                      @map("company_id") @db.Uuid
  contractorId   String?                     @map("contractor_id") @db.Uuid
  payeeName      String                      @map("payee_name") @db.VarChar(200)
  paidOn         DateTime                    @map("paid_on") @db.Date
  amountCents    BigInt                      @map("amount_cents")
  method         ReceiptMethod
  reference      String?                     @db.VarChar(100)
  idempotencyKey String                      @map("idempotency_key") @db.VarChar(200)
  requestHash    String                      @map("request_hash") @db.Char(64)
  voidReason     String?                     @map("void_reason") @db.VarChar(500)
  voidedAt       DateTime?                   @map("voided_at") @db.Timestamptz(3)
  voidedBy       String?                     @map("voided_by") @db.Uuid
  createdAt      DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy      String                      @map("created_by") @db.Uuid
  company        Company                     @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  contractor     Contractor?                 @relation(fields: [companyId, contractorId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)
  creator        Membership                  @relation("SupplierPaymentCreator", fields: [companyId, createdBy], references: [companyId, userId], onDelete: NoAction, onUpdate: NoAction)
  voider         Membership?                 @relation("SupplierPaymentVoider", fields: [companyId, voidedBy], references: [companyId, userId], onDelete: NoAction, onUpdate: NoAction)
  allocations    SupplierPaymentAllocation[]

  @@unique([companyId, idempotencyKey])
  @@unique([companyId, id])
  @@index([companyId, paidOn])
  @@index([companyId, contractorId])
  @@index([companyId, createdBy])
  @@map("supplier_payments")
}

model SupplierPaymentAllocation {
  id                           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId                    String          @map("company_id") @db.Uuid
  paymentId                    String          @map("payment_id") @db.Uuid
  billId                       String          @map("bill_id") @db.Uuid
  amountCents                  BigInt          @map("amount_cents")
  /// Cash-basis input tax credit attributed to this allocation (R7).
  creditableGstAttributedCents BigInt          @map("creditable_gst_attributed_cents")
  payment                      SupplierPayment @relation(fields: [companyId, paymentId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)
  bill                         SupplierBill    @relation(fields: [companyId, billId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([paymentId, billId])
  @@index([companyId, billId])
  @@map("supplier_payment_allocations")
}
