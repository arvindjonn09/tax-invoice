generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  owner
  manager
  accountant
  employee
  subcontractor

  @@map("membership_role")
}

enum IdempotencyState {
  pending
  completed

  @@map("idempotency_state")
}

model User {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String        @unique @db.VarChar(320)
  name          String?       @db.VarChar(200)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy     String?       @map("created_by") @db.Uuid
  creator       User?         @relation("UserCreator", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdUsers  User[]        @relation("UserCreator")
  memberships   Membership[]
  // Better Auth (#13): identity fields and credential/session records.
  emailVerified Boolean       @default(false) @map("email_verified")
  image         String?       @db.VarChar(2048)
  sessions      AuthSession[]
  accounts      AuthAccount[]

  @@index([createdBy])
  @@map("users")
}

/// Server-side login session (#13). The token is the opaque cookie value; revoke by deleting the row.
model AuthSession {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  token           String   @unique @db.VarChar(255)
  expiresAt       DateTime @map("expires_at") @db.Timestamptz(3)
  ipAddress       String?  @map("ip_address") @db.VarChar(64)
  userAgent       String?  @map("user_agent") @db.VarChar(512)
  userId          String   @map("user_id") @db.Uuid
  /// Company the session acts in; must match an active membership (checked on every request).
  activeCompanyId String?  @map("active_company_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeCompany   Company? @relation(fields: [activeCompanyId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

/// Credential (password hash) or future external-provider link for a user (#13).
model AuthAccount {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId             String    @map("account_id") @db.VarChar(255)
  providerId            String    @map("provider_id") @db.VarChar(64)
  userId                String    @map("user_id") @db.Uuid
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?   @db.VarChar(1024)
  password              String?   @db.VarChar(512)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("auth_accounts")
}

/// Short-lived verification tokens (password reset, email verification) (#13).
model AuthVerification {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identifier String   @db.VarChar(255)
  value      String   @db.VarChar(1024)
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  @@map("auth_verifications")
}

/// Login/request throttling counters shared by every app instance (#13).
model AuthRateLimit {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String @unique @db.VarChar(255)
  count       Int
  lastRequest BigInt @map("last_request")

  @@map("auth_rate_limits")
}

model Company {
  id               String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String                   @db.VarChar(200)
  isDemo           Boolean                  @default(false) @map("is_demo")
  legalName        String?                  @map("legal_name") @db.VarChar(200)
  /// 11 digits, checksum-validated by the application (#25).
  abn              String?                  @db.Char(11)
  addressLine1     String?                  @map("address_line1") @db.VarChar(200)
  addressLine2     String?                  @map("address_line2") @db.VarChar(200)
  suburb           String?                  @db.VarChar(100)
  state            String?                  @db.VarChar(3)
  postcode         String?                  @db.Char(4)
  invoicePrefix    String                   @default("INV-") @map("invoice_prefix") @db.VarChar(10)
  jobPrefix        String                   @default("JOB-") @map("job_prefix") @db.VarChar(10)
  basPeriod        BasReportingPeriod       @default(quarterly) @map("bas_period")
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy        String                   @map("created_by") @db.Uuid
  // Migration defers this FK until commit so company + first owner can be atomic.
  creator          Membership               @relation("CompanyCreator", fields: [id, createdBy], references: [companyId, userId], onDelete: NoAction, onUpdate: NoAction)
  memberships      Membership[]             @relation("CompanyMemberships")
  auditEvents      AuditEvent[]
  idempotencyKeys  IdempotencyKey[]
  authSessions     AuthSession[]
  gstRegistrations CompanyGstRegistration[]
  employees        Employee[]
  customers        Customer[]
  numberSequences  NumberSequence[]
  documents        Document[]
  contractors      Contractor[]

  userInvitations          UserInvitation[]
  defaultExpenseSettlement ExpenseSettlement @default(paid_at_purchase) @map("default_expense_settlement")
  expenses                 Expense[]

  @@map("companies")
}

enum GstAccountingBasis {
  cash
  non_cash

  @@map("gst_accounting_basis")
}

enum BasReportingPeriod {
  monthly
  quarterly

  @@map("bas_reporting_period")
}

/// A period during which the company IS registered for GST (inclusive dates;
/// endsOn null = open-ended). Overlaps are rejected by an exclusion constraint.
model CompanyGstRegistration {
  id        String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String             @map("company_id") @db.Uuid
  startsOn  DateTime           @map("starts_on") @db.Date
  endsOn    DateTime?          @map("ends_on") @db.Date
  basis     GstAccountingBasis
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy String             @map("created_by") @db.Uuid
  company   Company            @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  creator   Membership         @relation(fields: [companyId, createdBy], references: [companyId, userId], onDelete: NoAction, onUpdate: NoAction)

  @@index([companyId, startsOn])
  @@index([companyId, createdBy])
  @@map("company_gst_registrations")
}

model Membership {
  id                 String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId          String                   @map("company_id") @db.Uuid
  userId             String                   @map("user_id") @db.Uuid
  role               MembershipRole
  isActive           Boolean                  @default(true) @map("is_active")
  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy          String                   @map("created_by") @db.Uuid
  company            Company                  @relation("CompanyMemberships", fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user               User                     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  creator            Membership               @relation("MembershipCreator", fields: [companyId, createdBy], references: [companyId, userId], onDelete: NoAction, onUpdate: NoAction)
  createdMemberships Membership[]             @relation("MembershipCreator")
  createdCompanies   Company[]                @relation("CompanyCreator")
  auditEvents        AuditEvent[]
  idempotencyKeys    IdempotencyKey[]
  gstRegistrations   CompanyGstRegistration[]
  employeesCreated   Employee[]               @relation("EmployeeCreator")
  employeeRecords    Employee[]               @relation("EmployeeUser")
  customersCreated   Customer[]
  contactsCreated    CustomerContact[]
  locationsCreated   Location[]
  jobsCreated        Job[]
  jobEventsCreated   JobStatusEvent[]
  jobVisitsCreated   JobVisit[]
  assignmentsCreated Assignment[]             @relation("AssignmentCreator")
  assignmentsEnded   Assignment[]             @relation("AssignmentEnder")
  documentsCreated   Document[]
  contractorsCreated Contractor[]             @relation("ContractorCreator")
  contractorRecords  Contractor[]             @relation("ContractorUser")
  offersCreated      ContractorOffer[]        @relation("ContractorOfferCreator")
  offersResponded    ContractorOffer[]        @relation("ContractorOfferResponder")
  acceptances        ContractorAcceptance[]

  invitationsCreated UserInvitation[]
  expensesSubmitted  Expense[]        @relation("ExpenseSubmitter")
  expensesDecided    Expense[]        @relation("ExpenseDecider")

  @@unique([companyId, userId])
  @@index([userId])
  @@index([companyId, createdBy])
  @@map("memberships")
}

model AuditEvent {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId  String     @map("company_id") @db.Uuid
  createdBy  String     @map("created_by") @db.Uuid
  action     String     @db.VarChar(100)
  targetType String     @map("target_type") @db.VarChar(100)
  targetId   String     @map("target_id") @db.VarChar(200)
  metadata   Json       @default("{}")
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  company    Company    @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  creator    Membership @relation(fields: [companyId, createdBy], references: [companyId, userId], onDelete: NoAction, onUpdate: NoAction)

  @@index([companyId, createdAt, id])
  @@index([companyId, targetType, targetId])
  @@index([companyId, createdBy])
  @@map("audit_events")
}

model IdempotencyKey {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId      String           @map("company_id") @db.Uuid
  key            String           @db.VarChar(200)
  requestHash    String           @map("request_hash") @db.VarChar(64)
  state          IdempotencyState @default(pending)
  responseStatus Int?             @map("response_status")
  responseBody   Json?            @map("response_body")
  createdBy      String           @map("created_by") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  company        Company          @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  creator        Membership       @relation(fields: [companyId, createdBy], references: [companyId, userId], onDelete: NoAction, onUpdate: NoAction)

  @@unique([companyId, key])
  @@index([companyId, createdBy])
  @@map("idempotency_keys")
}

/// An employee who can be assigned to jobs (#30). No payroll data.
/// Optionally linked to a user account of the same company.
model Employee {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String       @map("company_id") @db.Uuid
  userId      String?      @map("user_id") @db.Uuid
  name        String       @db.VarChar(200)
  email       String?      @db.VarChar(320)
  phone       String?      @db.VarChar(30)
  isActive    Boolean      @default(true) @map("is_active")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy   String       @map("created_by") @db.Uuid
  company     Company      @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user        Membership?  @relation("EmployeeUser", fields: [companyId, userId], references: [companyId, userId], onDelete: NoAction, onUpdate: NoAction)
  creator     Membership   @relation("EmployeeCreator", fields: [companyId, createdBy], references: [companyId, userId], onDelete: NoAction, onUpdate: NoAction)
  assignments Assignment[]

  @@unique([companyId, id])
  @@unique([companyId, userId])
  @@index([companyId, isActive, name])
  @@index([companyId, createdBy])
  @@map("employees")
}

/// Customer directory (#28). Archived (never deleted) once no longer used.
model Customer {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId    String            @map("company_id") @db.Uuid
  name         String            @db.VarChar(200)
  /// 11 digits, checksum-validated by the application.
  abn          String?           @db.Char(11)
  billingEmail String?           @map("billing_email") @db.VarChar(320)
  billingPhone String?           @map("billing_phone") @db.VarChar(30)
  addressLine1 String?           @map("address_line1") @db.VarChar(200)
  addressLine2 String?           @map("address_line2") @db.VarChar(200)
  suburb       String?           @db.VarChar(100)
  state        String?           @db.VarChar(3)
  postcode     String?           @db.Char(4)
  archivedAt   DateTime?         @map("archived_at") @db.Timestamptz(3)
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy    String            @map("created_by") @db.Uuid
  company      Company           @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  creator      Membership        @relation(fields: [companyId, createdBy], references: [companyId, userId], onDelete: NoAction, onUpdate: NoAction)
  contacts     CustomerContact[]
  locations    Location[]
  jobs         Job[]

  @@unique([companyId, id])
  @@index([companyId, archivedAt, name])
  @@index([companyId, createdBy])
  @@map("customers")
}

/// SQL partial unique index customer_contacts_one_primary enforces one active primary per customer.
model CustomerContact {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId  String     @map("company_id") @db.Uuid
  customerId String     @map("customer_id") @db.Uuid
  name       String     @db.VarChar(200)
  position   String?    @db.VarChar(100)
  email      String?    @db.VarChar(320)
  phone      String?    @db.VarChar(30)
  isPrimary  Boolean    @default(false) @map("is_primary")
  archivedAt DateTime?  @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy  String     @map("created_by") @db.Uuid
  customer   Customer   @relation(fields: [companyId, customerId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)
  creator    Membership @relation(fields: [companyId, createdBy], references: [companyId, userId], onDelete: NoAction, onUpdate: NoAction)

  @@unique([companyId, id])
  @@index([companyId, customerId])
  @@index([companyId, createdBy])
  @@map("customer_contacts")
}

/// A customer's service location (job site).
model Location {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId    String     @map("company_id") @db.Uuid
  customerId   String     @map("customer_id") @db.Uuid
  label        String?    @db.VarChar(100)
  addressLine1 String     @map("address_line1") @db.VarChar(200)
  addressLine2 String?    @map("address_line2") @db.VarChar(200)
  suburb       String     @db.VarChar(100)
  state        String     @db.VarChar(3)
  postcode     String     @db.Char(4)
  accessNotes  String?    @map("access_notes") @db.VarChar(500)
  archivedAt   DateTime?  @map("archived_at") @db.Timestamptz(3)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy    String     @map("created_by") @db.Uuid
  customer     Customer   @relation(fields: [companyId, customerId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)
  creator      Membership @relation(fields: [companyId, createdBy], references: [companyId, userId], onDelete: NoAction, onUpdate: NoAction)
  jobs         Job[]

  @@unique([companyId, id])
  @@unique([companyId, customerId, id])
  @@index([companyId, customerId])
  @@index([companyId, createdBy])
  @@map("locations")
}

/// Per-company counters for human numbers ("job", later "invoice").
model NumberSequence {
  companyId String  @map("company_id") @db.Uuid
  kind      String  @db.VarChar(20)
  lastValue Int     @default(0) @map("last_value")
  company   Company @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([companyId, kind])
  @@map("number_sequences")
}

enum JobStatus {
  draft
  quoted
  approved
  assigned
  in_progress
  awaiting_review
  completed
  invoiced
  closed
  cancelled

  @@map("job_status")
}

enum JobVisitStatus {
  scheduled
  completed
  cancelled

  @@map("job_visit_status")
}

/// The core work order (#31). Price is GST-exclusive integer cents.
model Job {
  id                        String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId                 String            @map("company_id") @db.Uuid
  number                    Int
  reference                 String            @db.VarChar(30)
  customerId                String            @map("customer_id") @db.Uuid
  locationId                String?           @map("location_id") @db.Uuid
  title                     String            @db.VarChar(200)
  description               String?           @db.VarChar(4000)
  status                    JobStatus         @default(draft)
  agreedPriceExclusiveCents BigInt?           @map("agreed_price_exclusive_cents")
  dueOn                     DateTime?         @map("due_on") @db.Date
  createdAt                 DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy                 String            @map("created_by") @db.Uuid
  customer                  Customer          @relation(fields: [companyId, customerId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)
  location                  Location?         @relation(fields: [companyId, customerId, locationId], references: [companyId, customerId, id], onDelete: NoAction, onUpdate: NoAction)
  creator                   Membership        @relation(fields: [companyId, createdBy], references: [companyId, userId], onDelete: NoAction, onUpdate: NoAction)
  statusEvents              JobStatusEvent[]
  visits                    JobVisit[]
  assignments               Assignment[]
  contractorOffers          ContractorOffer[]
  expenses                  Expense[]

  @@unique([companyId, number])
  @@unique([companyId, id])
  @@index([companyId, status])
  @@index([companyId, customerId])
  @@index([companyId, createdBy])
  @@map("jobs")
}

/// Immutable status history (database trigger refuses UPDATE/DELETE/TRUNCATE).
model JobStatusEvent {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Monotonic insertion order; the timeline sorts by this.
  seq        BigInt     @unique @default(autoincrement())
  companyId  String     @map("company_id") @db.Uuid
  jobId      String     @map("job_id") @db.Uuid
  fromStatus JobStatus? @map("from_status")
  toStatus   JobStatus  @map("to_status")
  note       String?    @db.VarChar(500)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy  String     @map("created_by") @db.Uuid
  job        Job        @relation(fields: [companyId, jobId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)
  creator    Membership @relation(fields: [companyId, createdBy], references: [companyId, userId], onDelete: NoAction, onUpdate: NoAction)

  @@index([companyId, jobId, seq])
  @@index([companyId, createdBy])
  @@map("job_status_events")
}

model JobVisit {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String         @map("company_id") @db.Uuid
  jobId       String         @map("job_id") @db.Uuid
  startsAt    DateTime       @map("starts_at") @db.Timestamptz(3)
  endsAt      DateTime?      @map("ends_at") @db.Timestamptz(3)
  status      JobVisitStatus @default(scheduled)
  notes       String?        @db.VarChar(1000)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy   String         @map("created_by") @db.Uuid
  job         Job            @relation(fields: [companyId, jobId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)
  creator     Membership     @relation(fields: [companyId, createdBy], references: [companyId, userId], onDelete: NoAction, onUpdate: NoAction)
  assignments Assignment[]

  @@unique([companyId, id])
  @@unique([companyId, jobId, id])
  @@index([companyId, jobId, startsAt])
  @@index([companyId, createdBy])
  @@map("job_visits")
}

/// Owner-issued, expiring one-use invitation (#27). Only SHA-256 token digests are stored.
model UserInvitation {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId  String         @map("company_id") @db.Uuid
  email      String         @db.VarChar(320)
  role       MembershipRole
  tokenHash  String         @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime       @map("expires_at") @db.Timestamptz(3)
  acceptedAt DateTime?      @map("accepted_at") @db.Timestamptz(3)
  revokedAt  DateTime?      @map("revoked_at") @db.Timestamptz(3)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy  String         @map("created_by") @db.Uuid
  company    Company        @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  creator    Membership     @relation(fields: [companyId, createdBy], references: [companyId, userId], onDelete: NoAction, onUpdate: NoAction)

  @@index([companyId, createdAt, id])
  @@index([companyId, createdBy])
  @@map("user_invitations")
}

/// An employee assigned to a whole job (visitId null) or one of its visits
/// (#32). Ended, never deleted. Partial unique indexes (migration) allow one
/// live assignment per employee per job/visit.
model Assignment {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId  String      @map("company_id") @db.Uuid
  jobId      String      @map("job_id") @db.Uuid
  employeeId String      @map("employee_id") @db.Uuid
  visitId    String?     @map("visit_id") @db.Uuid
  assignedAt DateTime    @default(now()) @map("assigned_at") @db.Timestamptz(3)
  endedAt    DateTime?   @map("ended_at") @db.Timestamptz(3)
  endedBy    String?     @map("ended_by") @db.Uuid
  createdBy  String      @map("created_by") @db.Uuid
  job        Job         @relation(fields: [companyId, jobId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)
  employee   Employee    @relation(fields: [companyId, employeeId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)
  visit      JobVisit?   @relation(fields: [companyId, jobId, visitId], references: [companyId, jobId, id], onDelete: NoAction, onUpdate: NoAction)
  creator    Membership  @relation("AssignmentCreator", fields: [companyId, createdBy], references: [companyId, userId], onDelete: NoAction, onUpdate: NoAction)
  ender      Membership? @relation("AssignmentEnder", fields: [companyId, endedBy], references: [companyId, userId], onDelete: NoAction, onUpdate: NoAction)

  @@unique([companyId, id])
  @@index([companyId, employeeId, endedAt])
  @@index([companyId, jobId])
  @@index([companyId, createdBy])
  @@map("assignments")
}

enum DocumentKind {
  receipt
  photo
  tax_invoice
  other

  @@map("document_kind")
}

/// A private file (#34). Bytes live in S3-compatible storage under a random
/// key; reached only through an authorised, short-lived signed link.
model Document {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String       @map("company_id") @db.Uuid
  kind        DocumentKind
  objectKey   String       @unique @map("object_key") @db.VarChar(200)
  fileName    String       @map("file_name") @db.VarChar(200)
  contentType String       @map("content_type") @db.VarChar(100)
  sizeBytes   Int          @map("size_bytes")
  sha256      String       @db.Char(64)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy   String       @map("created_by") @db.Uuid
  company     Company      @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  creator     Membership   @relation(fields: [companyId, createdBy], references: [companyId, userId], onDelete: NoAction, onUpdate: NoAction)
  expense     Expense?

  @@unique([companyId, id])
  @@index([companyId, createdBy])
  @@map("documents")
}

enum ContractorRateType {
  fixed
  hourly

  @@map("contractor_rate_type")
}

/// GST treatment of a line (docs/GST.md).
enum TaxCode {
  TAXABLE_10
  GST_FREE
  INPUT_TAXED
  OUT_OF_SCOPE

  @@map("tax_code")
}

enum ContractorOfferStatus {
  offered
  accepted
  declined
  withdrawn

  @@map("contractor_offer_status")
}

/// A subcontractor business (#35). Archived, never deleted.
model Contractor {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId     String            @map("company_id") @db.Uuid
  userId        String?           @map("user_id") @db.Uuid
  name          String            @db.VarChar(200)
  /// 11 digits, checksum-validated by the application.
  abn           String?           @db.Char(11)
  gstRegistered Boolean           @default(false) @map("gst_registered")
  email         String?           @db.VarChar(320)
  phone         String?           @db.VarChar(30)
  archivedAt    DateTime?         @map("archived_at") @db.Timestamptz(3)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy     String            @map("created_by") @db.Uuid
  company       Company           @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user          Membership?       @relation("ContractorUser", fields: [companyId, userId], references: [companyId, userId], onDelete: NoAction, onUpdate: NoAction)
  creator       Membership        @relation("ContractorCreator", fields: [companyId, createdBy], references: [companyId, userId], onDelete: NoAction, onUpdate: NoAction)
  offers        ContractorOffer[]

  @@unique([companyId, id])
  @@unique([companyId, userId])
  @@index([companyId, archivedAt, name])
  @@index([companyId, createdBy])
  @@map("contractors")
}

/// An offer of work on a job (#35). GST-exclusive cents. A SQL trigger freezes
/// it once closed; the partial unique index contractor_offers_live_key allows
/// one open-or-accepted offer per contractor per job.
model ContractorOffer {
  id                       String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId                String                @map("company_id") @db.Uuid
  jobId                    String                @map("job_id") @db.Uuid
  contractorId             String                @map("contractor_id") @db.Uuid
  scope                    String                @db.VarChar(2000)
  rateType                 ContractorRateType    @map("rate_type")
  rateExclusiveCents       BigInt                @map("rate_exclusive_cents")
  estimatedHoursHundredths Int?                  @map("estimated_hours_hundredths")
  taxCode                  TaxCode               @map("tax_code")
  status                   ContractorOfferStatus @default(offered)
  responseNote             String?               @map("response_note") @db.VarChar(500)
  respondedAt              DateTime?             @map("responded_at") @db.Timestamptz(3)
  respondedBy              String?               @map("responded_by") @db.Uuid
  createdAt                DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy                String                @map("created_by") @db.Uuid
  job                      Job                   @relation(fields: [companyId, jobId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)
  contractor               Contractor            @relation(fields: [companyId, contractorId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)
  creator                  Membership            @relation("ContractorOfferCreator", fields: [companyId, createdBy], references: [companyId, userId], onDelete: NoAction, onUpdate: NoAction)
  responder                Membership?           @relation("ContractorOfferResponder", fields: [companyId, respondedBy], references: [companyId, userId], onDelete: NoAction, onUpdate: NoAction)
  acceptance               ContractorAcceptance?

  @@unique([companyId, id])
  @@unique([companyId, id, jobId, contractorId])
  @@index([companyId, jobId])
  @@index([companyId, contractorId, status])
  @@index([companyId, createdBy])
  @@index([companyId, respondedBy])
  @@map("contractor_offers")
}

/// Append-only snapshot of an accepted offer; records the committed cost once.
model ContractorAcceptance {
  id                       String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId                String             @map("company_id") @db.Uuid
  offerId                  String             @unique @map("offer_id") @db.Uuid
  jobId                    String             @map("job_id") @db.Uuid
  contractorId             String             @map("contractor_id") @db.Uuid
  rateType                 ContractorRateType @map("rate_type")
  rateExclusiveCents       BigInt             @map("rate_exclusive_cents")
  estimatedHoursHundredths Int?               @map("estimated_hours_hundredths")
  taxCode                  TaxCode            @map("tax_code")
  gstRateBasisPoints       Int                @map("gst_rate_basis_points")
  exclusiveCents           BigInt             @map("exclusive_cents")
  gstCents                 BigInt             @map("gst_cents")
  inclusiveCents           BigInt             @map("inclusive_cents")
  contractorGstRegistered  Boolean            @map("contractor_gst_registered")
  companyGstRegistered     Boolean            @map("company_gst_registered")
  committedCostCents       BigInt             @map("committed_cost_cents")
  acceptedAt               DateTime           @default(now()) @map("accepted_at") @db.Timestamptz(3)
  acceptedBy               String             @map("accepted_by") @db.Uuid
  offer                    ContractorOffer    @relation(fields: [companyId, offerId, jobId, contractorId], references: [companyId, id, jobId, contractorId], onDelete: NoAction, onUpdate: NoAction, map: "contractor_acceptances_offer_fkey")
  acceptor                 Membership         @relation(fields: [companyId, acceptedBy], references: [companyId, userId], onDelete: NoAction, onUpdate: NoAction)

  @@unique([companyId, offerId, jobId, contractorId])
  @@index([companyId, jobId])
  @@index([companyId, contractorId])
  @@index([companyId, acceptedBy])
  @@map("contractor_acceptances")
}

enum ExpenseCategory {
  materials
  travel
  parking
  equipment
  misc

  @@map("expense_category")
}

enum PriceEntry {
  exclusive
  inclusive

  @@map("price_entry")
}

enum ExpenseSettlement {
  paid_at_purchase
  on_account

  @@map("expense_settlement")
}

enum PaymentMethod {
  card
  cash
  bank_transfer
  other

  @@map("payment_method")
}

enum ExpenseStatus {
  submitted
  approved
  rejected

  @@map("expense_status")
}

/// A job or general expense (#40). Cost is incurred once, on approval, from
/// the snapshot columns; a SQL trigger freezes decided expenses and a
/// correction is an approved reversal (reversesId) with negated cents.
model Expense {
  id                    String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId             String             @map("company_id") @db.Uuid
  jobId                 String?            @map("job_id") @db.Uuid
  category              ExpenseCategory
  description           String             @db.VarChar(500)
  supplierName          String?            @map("supplier_name") @db.VarChar(200)
  purchasedOn           DateTime           @map("purchased_on") @db.Date
  priceEntry            PriceEntry         @map("price_entry")
  enteredAmountCents    BigInt             @map("entered_amount_cents")
  taxCode               TaxCode            @map("tax_code")
  gstRateBasisPoints    Int                @map("gst_rate_basis_points")
  exclusiveCents        BigInt             @map("exclusive_cents")
  gstCents              BigInt             @map("gst_cents")
  inclusiveCents        BigInt             @map("inclusive_cents")
  creditableBasisPoints Int                @default(10000) @map("creditable_basis_points")
  receiptDocumentId     String?            @map("receipt_document_id") @db.Uuid
  settlement            ExpenseSettlement?
  paidOn                DateTime?          @map("paid_on") @db.Date
  paymentMethod         PaymentMethod?     @map("payment_method")
  status                ExpenseStatus      @default(submitted)
  decisionNote          String?            @map("decision_note") @db.VarChar(500)
  decidedAt             DateTime?          @map("decided_at") @db.Timestamptz(3)
  decidedBy             String?            @map("decided_by") @db.Uuid
  companyGstRegistered  Boolean?           @map("company_gst_registered")
  evidenceVerified      Boolean?           @map("evidence_verified")
  hasEvidence           Boolean?           @map("has_evidence")
  creditableGstCents    BigInt?            @map("creditable_gst_cents")
  nonCreditableGstCents BigInt?            @map("non_creditable_gst_cents")
  jobCostCents          BigInt?            @map("job_cost_cents")
  reversesId            String?            @map("reverses_id") @db.Uuid
  submittedBy           String             @map("submitted_by") @db.Uuid
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  company               Company            @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  job                   Job?               @relation(fields: [companyId, jobId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)
  receipt               Document?          @relation(fields: [companyId, receiptDocumentId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)
  reverses              Expense?           @relation("ExpenseReversal", fields: [companyId, reversesId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)
  reversedBy            Expense?           @relation("ExpenseReversal")
  submitter             Membership         @relation("ExpenseSubmitter", fields: [companyId, submittedBy], references: [companyId, userId], onDelete: NoAction, onUpdate: NoAction)
  decider               Membership?        @relation("ExpenseDecider", fields: [companyId, decidedBy], references: [companyId, userId], onDelete: NoAction, onUpdate: NoAction)

  @@unique([companyId, id])
  @@unique([companyId, receiptDocumentId])
  @@unique([companyId, reversesId])
  @@index([companyId, jobId])
  @@index([companyId, status, purchasedOn])
  @@index([companyId, submittedBy])
  @@index([companyId, decidedBy])
  @@map("expenses")
}
