/// A subcontractor business (#35). Archived, never deleted.
model Contractor {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId     String            @map("company_id") @db.Uuid
  userId        String?           @map("user_id") @db.Uuid
  name          String            @db.VarChar(200)
  /// 11 digits, checksum-validated by the application.
  abn           String?           @db.Char(11)
  gstRegistered Boolean           @default(false) @map("gst_registered")
  email         String?           @db.VarChar(320)
  phone         String?           @db.VarChar(30)
  archivedAt    DateTime?         @map("archived_at") @db.Timestamptz(3)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy     String            @map("created_by") @db.Uuid
  company       Company           @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user          Membership?       @relation("ContractorUser", fields: [companyId, userId], references: [companyId, userId], onDelete: NoAction, onUpdate: NoAction)
  creator       Membership        @relation("ContractorCreator", fields: [companyId, createdBy], references: [companyId, userId], onDelete: NoAction, onUpdate: NoAction)
  offers        ContractorOffer[]

  bills    SupplierBill[]
  payments SupplierPayment[]

  @@unique([companyId, id])
  @@unique([companyId, userId])
  @@index([companyId, archivedAt, name])
  @@index([companyId, createdBy])
  @@map("contractors")
}

/// An offer of work on a job (#35). GST-exclusive cents. A SQL trigger freezes
/// it once closed; the partial unique index contractor_offers_live_key allows
/// one open-or-accepted offer per contractor per job.
model ContractorOffer {
  id                       String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId                String                @map("company_id") @db.Uuid
  jobId                    String                @map("job_id") @db.Uuid
  contractorId             String                @map("contractor_id") @db.Uuid
  scope                    String                @db.VarChar(2000)
  rateType                 ContractorRateType    @map("rate_type")
  rateExclusiveCents       BigInt                @map("rate_exclusive_cents")
  estimatedHoursHundredths Int?                  @map("estimated_hours_hundredths")
  taxCode                  TaxCode               @map("tax_code")
  status                   ContractorOfferStatus @default(offered)
  responseNote             String?               @map("response_note") @db.VarChar(500)
  respondedAt              DateTime?             @map("responded_at") @db.Timestamptz(3)
  respondedBy              String?               @map("responded_by") @db.Uuid
  createdAt                DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy                String                @map("created_by") @db.Uuid
  job                      Job                   @relation(fields: [companyId, jobId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)
  contractor               Contractor            @relation(fields: [companyId, contractorId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)
  creator                  Membership            @relation("ContractorOfferCreator", fields: [companyId, createdBy], references: [companyId, userId], onDelete: NoAction, onUpdate: NoAction)
  responder                Membership?           @relation("ContractorOfferResponder", fields: [companyId, respondedBy], references: [companyId, userId], onDelete: NoAction, onUpdate: NoAction)
  acceptance               ContractorAcceptance?

  @@unique([companyId, id])
  @@unique([companyId, id, jobId, contractorId])
  @@index([companyId, jobId])
  @@index([companyId, contractorId, status])
  @@index([companyId, createdBy])
  @@index([companyId, respondedBy])
  @@map("contractor_offers")
}

/// Append-only snapshot of an accepted offer; records the committed cost once.
model ContractorAcceptance {
  id                       String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId                String             @map("company_id") @db.Uuid
  offerId                  String             @unique @map("offer_id") @db.Uuid
  jobId                    String             @map("job_id") @db.Uuid
  contractorId             String             @map("contractor_id") @db.Uuid
  rateType                 ContractorRateType @map("rate_type")
  rateExclusiveCents       BigInt             @map("rate_exclusive_cents")
  estimatedHoursHundredths Int?               @map("estimated_hours_hundredths")
  taxCode                  TaxCode            @map("tax_code")
  gstRateBasisPoints       Int                @map("gst_rate_basis_points")
  exclusiveCents           BigInt             @map("exclusive_cents")
  gstCents                 BigInt             @map("gst_cents")
  inclusiveCents           BigInt             @map("inclusive_cents")
  contractorGstRegistered  Boolean            @map("contractor_gst_registered")
  companyGstRegistered     Boolean            @map("company_gst_registered")
  committedCostCents       BigInt             @map("committed_cost_cents")
  acceptedAt               DateTime           @default(now()) @map("accepted_at") @db.Timestamptz(3)
  acceptedBy               String             @map("accepted_by") @db.Uuid
  offer                    ContractorOffer    @relation(fields: [companyId, offerId, jobId, contractorId], references: [companyId, id, jobId, contractorId], onDelete: NoAction, onUpdate: NoAction, map: "contractor_acceptances_offer_fkey")
  acceptor                 Membership         @relation(fields: [companyId, acceptedBy], references: [companyId, userId], onDelete: NoAction, onUpdate: NoAction)

  bills SupplierBill[]

  /// PostgreSQL truncated the generated name to its 63-byte identifier limit.
  @@unique([companyId, offerId, jobId, contractorId], map: "contractor_acceptances_company_id_offer_id_job_id_contractor_id")
  @@index([companyId, jobId])
  @@index([companyId, contractorId])
  @@index([companyId, acceptedBy])
  @@map("contractor_acceptances")
}

enum InvoiceKind {
  invoice
  credit_note

  @@map("invoice_kind")
}

enum InvoiceStatus {
  draft
  issued
  void

  @@map("invoice_status")
}

enum InvoicePriceEntry {
  exclusive
  inclusive

  @@map("invoice_price_entry")
}

/// Customer invoice or credit note (#47). Editable as a draft; issuing
/// assigns the number and freezes amounts, lines and party snapshots
/// (database guard). Corrections are credit notes or a void.
model Invoice {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId         String            @map("company_id") @db.Uuid
  kind              InvoiceKind       @default(invoice)
  status            InvoiceStatus     @default(draft)
  customerId        String            @map("customer_id") @db.Uuid
  jobId             String?           @map("job_id") @db.Uuid
  locationId        String?           @map("location_id") @db.Uuid
  creditsId         String?           @map("credits_id") @db.Uuid
  priceEntry        InvoicePriceEntry @default(exclusive) @map("price_entry")
  customerReference String?           @map("customer_reference") @db.VarChar(100)
  notes             String?           @db.VarChar(2000)
  dueOn             DateTime?         @map("due_on") @db.Date
  number            Int?
  reference         String?           @db.VarChar(30)
  issueDate         DateTime?         @map("issue_date") @db.Date
  title             String?           @db.VarChar(20)
  gstRegistered     Boolean?          @map("gst_registered")
  supplierSnapshot  Json?             @map("supplier_snapshot")
  customerSnapshot  Json?             @map("customer_snapshot")
  siteSnapshot      Json?             @map("site_snapshot")
  exclusiveCents    BigInt            @default(0) @map("exclusive_cents")
  gstCents          BigInt            @default(0) @map("gst_cents")
  inclusiveCents    BigInt            @default(0) @map("inclusive_cents")
  issuedAt          DateTime?         @map("issued_at") @db.Timestamptz(3)
  issuedBy          String?           @map("issued_by") @db.Uuid
  voidReason        String?           @map("void_reason") @db.VarChar(500)
  voidedAt          DateTime?         @map("voided_at") @db.Timestamptz(3)
  voidedBy          String?           @map("voided_by") @db.Uuid
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy         String            @map("created_by") @db.Uuid
  customer          Customer          @relation(fields: [companyId, customerId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)
  job               Job?              @relation(fields: [companyId, jobId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)
  location          Location?         @relation(fields: [companyId, customerId, locationId], references: [companyId, customerId, id], onDelete: NoAction, onUpdate: NoAction)
  credits           Invoice?          @relation("CreditNote", fields: [companyId, creditsId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)
  creditNotes       Invoice[]         @relation("CreditNote")
  creator           Membership        @relation("InvoiceCreator", fields: [companyId, createdBy], references: [companyId, userId], onDelete: NoAction, onUpdate: NoAction)
  issuer            Membership?       @relation("InvoiceIssuer", fields: [companyId, issuedBy], references: [companyId, userId], onDelete: NoAction, onUpdate: NoAction)
  voider            Membership?       @relation("InvoiceVoider", fields: [companyId, voidedBy], references: [companyId, userId], onDelete: NoAction, onUpdate: NoAction)
  items             InvoiceItem[]

  allocations    ReceiptAllocation[]
  gstAdjustments ReceiptGstAdjustment[]

  @@unique([companyId, id])
  @@unique([companyId, kind, number])
  @@index([companyId, status, issueDate])
  @@index([companyId, customerId])
  @@index([companyId, jobId])
  @@index([companyId, creditsId])
  @@index([companyId, createdBy])
  @@map("invoices")
}

/// A line as entered plus its rounded amounts (snapshotted; frozen at issue).
model InvoiceItem {
  id                 String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId          String  @map("company_id") @db.Uuid
  invoiceId          String  @map("invoice_id") @db.Uuid
  position           Int
  description        String  @db.VarChar(500)
  quantity           String  @db.VarChar(20)
  unit               String? @db.VarChar(20)
  unitPriceCents     BigInt  @map("unit_price_cents")
  taxCode            TaxCode @map("tax_code")
  gstRateBasisPoints Int     @map("gst_rate_basis_points")
  exclusiveCents     BigInt  @map("exclusive_cents")
  gstCents           BigInt  @map("gst_cents")
  inclusiveCents     BigInt  @map("inclusive_cents")
  invoice            Invoice @relation(fields: [companyId, invoiceId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([invoiceId, position])
  @@index([companyId, invoiceId])
  @@map("invoice_items")
}

enum ReceiptKind {
  receipt
  refund

  @@map("receipt_kind")
}

enum ReceiptMethod {
  bank_transfer
  card
  cash
  cheque
  other

  @@map("receipt_method")
}

/// Money received from (or refunded to) a customer (#50). Idempotent by
/// (company, idempotencyKey); immutable except a one-way void.
model CustomerReceipt {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId      String              @map("company_id") @db.Uuid
  customerId     String              @map("customer_id") @db.Uuid
  kind           ReceiptKind         @default(receipt)
  receivedOn     DateTime            @map("received_on") @db.Date
  amountCents    BigInt              @map("amount_cents")
  method         ReceiptMethod
  reference      String?             @db.VarChar(100)
  idempotencyKey String              @map("idempotency_key") @db.VarChar(200)
  requestHash    String              @map("request_hash") @db.Char(64)
  voidReason     String?             @map("void_reason") @db.VarChar(500)
  voidedAt       DateTime?           @map("voided_at") @db.Timestamptz(3)
  voidedBy       String?             @map("voided_by") @db.Uuid
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy      String              @map("created_by") @db.Uuid
  customer       Customer            @relation(fields: [companyId, customerId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)
  creator        Membership          @relation("ReceiptCreator", fields: [companyId, createdBy], references: [companyId, userId], onDelete: NoAction, onUpdate: NoAction)
  voider         Membership?         @relation("ReceiptVoider", fields: [companyId, voidedBy], references: [companyId, userId], onDelete: NoAction, onUpdate: NoAction)
  allocations    ReceiptAllocation[]
  gstAdjustments ReceiptGstAdjustment[]

  @@unique([companyId, idempotencyKey])
  @@unique([companyId, id])
  @@index([companyId, customerId])
  @@index([companyId, receivedOn])
  @@index([companyId, createdBy])
  @@map("customer_receipts")
}

model ReceiptAllocation {
  id                 String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId          String          @map("company_id") @db.Uuid
  receiptId          String          @map("receipt_id") @db.Uuid
  invoiceId          String          @map("invoice_id") @db.Uuid
  amountCents        BigInt          @map("amount_cents")
  /// Cash-basis GST attributed (negative for a refund).
  gstAttributedCents BigInt          @map("gst_attributed_cents")
  receipt            CustomerReceipt @relation(fields: [companyId, receiptId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)
  invoice            Invoice         @relation(fields: [companyId, invoiceId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([receiptId, invoiceId])
  @@index([companyId, invoiceId])
  @@map("receipt_allocations")
}

/// Cash-basis GST correction written when a receipt or refund is voided, so
/// an invoice's live GST (unvoided allocations plus adjustments) is always the
/// rounded share of the money still received. Append-only; dated on the void.
model ReceiptGstAdjustment {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId  String          @map("company_id") @db.Uuid
  /// The voided receipt or refund.
  receiptId  String          @map("receipt_id") @db.Uuid
  invoiceId  String          @map("invoice_id") @db.Uuid
  gstCents   BigInt          @map("gst_cents")
  adjustedOn DateTime        @map("adjusted_on") @db.Date
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  receipt    CustomerReceipt @relation(fields: [companyId, receiptId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)
  invoice    Invoice         @relation(fields: [companyId, invoiceId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([receiptId, invoiceId])
  @@index([companyId, invoiceId])
  @@map("receipt_gst_adjustments")
}

