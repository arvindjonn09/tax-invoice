# Documentation only. Run `pnpm db:env` for a private .env with random local credentials.
# Never use development credentials or this Compose setup in production.
# development | preview | staging | production. `next start` sets NODE_ENV=production,
# so non-production servers must set APP_ENV; demo accounts are refused only in production.
APP_ENV=development
POSTGRES_USER=jobflow
POSTGRES_PASSWORD=replace-with-random-local-password
POSTGRES_DB=jobflow
POSTGRES_PORT=5432
DATABASE_URL=postgresql://jobflow:replace-with-random-local-password@127.0.0.1:5432/jobflow
# Must be loopback, database exactly jobflow_test, no query/fragment, distinct from DATABASE_URL.
# The test role requires CREATEDB to provision a unique disposable DB for each test run.
TEST_DATABASE_URL=postgresql://jobflow:replace-with-random-local-password@127.0.0.1:5432/jobflow_test
MINIO_ROOT_USER=jobflow-local
MINIO_ROOT_PASSWORD=replace-with-random-local-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# Authentication (#13). Secret: 32+ random characters, unique per environment.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# Public origin of the app; sign-in POSTs from any other origin are rejected.
BETTER_AUTH_URL=http://localhost:3000
# Optional destructive test reset acknowledgement (never needed by test:integration):
# RESET_TEST_DATABASE=yes
# NODE_ENV is set by Next.js/tests; production NODE_ENV or APP_ENV forbids test/reset/env generation.
# JOBFLOW_ISOLATED_TEST_DATABASE is injected by the integration runner; do not set manually.
