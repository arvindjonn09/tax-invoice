# Documentation only. Run `pnpm db:env` for a private .env with random local credentials.
# Never use development credentials or this Compose setup in production.
#
# After editing .env, what makes each change take effect:
# - SMTP_*, EMAIL_*, S3_*, APP_ENV and the like: restart the app.
# - DEMO_PASSWORD: run `pnpm db:demo:password`. No restart is needed.
# - POSTGRES_PASSWORD and MINIO_ROOT_PASSWORD: change the password in that service first, then
#   update DATABASE_URL here to match, then restart. Editing .env alone doesn't change them.
# - BETTER_AUTH_SECRET: restart the app. Everyone is signed out.
# - EMAIL_OUTBOX_KEY: don't change it while email is queued; queued email can't be decrypted.
# development | preview | staging | production. `next start` sets NODE_ENV=production,
# so non-production servers must set APP_ENV; demo accounts are refused only in production.
APP_ENV=development
POSTGRES_USER=jobflow
POSTGRES_PASSWORD=replace-with-random-local-password
POSTGRES_DB=jobflow
POSTGRES_PORT=5432
DATABASE_URL=postgresql://jobflow:replace-with-random-local-password@127.0.0.1:5432/jobflow
# Must be loopback, database exactly jobflow_test, no query/fragment, distinct from DATABASE_URL.
# The test role requires CREATEDB to provision a unique disposable DB for each test run.
TEST_DATABASE_URL=postgresql://jobflow:replace-with-random-local-password@127.0.0.1:5432/jobflow_test
MINIO_ROOT_USER=jobflow-local
MINIO_ROOT_PASSWORD=replace-with-random-local-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# Private document storage (#34). Without S3_* the app uses the local MinIO above;
# with neither, uploads report "storage unavailable". Never use real keys here.
# S3_ENDPOINT=https://s3.ap-southeast-2.amazonaws.com
# S3_REGION=ap-southeast-2
# S3_BUCKET=jobflow-documents
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Password for the demo accounts: 12-128 characters. Used by `pnpm db:seed:demo` for new
# accounts and `pnpm db:demo:password` for existing ones. Never used in production.
# DEMO_PASSWORD=
# Authentication (#13). Secret: 32+ random characters, unique per environment.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# Public origin of the app; sign-in POSTs from any other origin are rejected.
BETTER_AUTH_URL=http://localhost:3000
# Email outbox encryption (#214): 32+ random characters, unique per environment.
EMAIL_OUTBOX_KEY=replace-with-at-least-32-random-characters
# Outgoing email via Zoho Mail (ADR 0004 D7). Without SMTP_* development prints
# links to the server console; production refuses to start sending.
# Use a Zoho app-specific password and never commit it.
# SMTP_HOST=smtppro.zoho.com.au
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=admin@shivomsangha.com
# SMTP_PASSWORD=
# EMAIL_FROM="JobFlow <admin@shivomsangha.com>"
# EMAIL_REPLY_TO=admin@shivomsangha.com
# SUPPORT_EMAIL=admin@shivomsangha.com
# OPERATOR_NOTIFY_EMAIL=admin@shivomsangha.com
# The one header the trusted proxy sets with the client's IP, for throttling.
# Tunnel straight to the app: use cf-connecting-ip, and the app must listen on
# 127.0.0.1 only, or a client can choose its own address.
# Behind nginx: leave unset. nginx overwrites X-Forwarded-For and drops this header.
# CLIENT_IP_HEADER=cf-connecting-ip
# Cloudflare Turnstile (#217): set both together. Without them production refuses
# sign-up, public resend and forgot-password with "couldn't confirm you're not a robot".
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# Admin console GitHub tab (#252): optional read-only fine-grained token (Pull
# requests, Issues, Actions, Checks: read); without it GitHub allows 60 requests/h.
# ADMIN_GITHUB_TOKEN=
# ADMIN_GITHUB_REPO=arvindjonn09/tax-invoice
# Optional destructive test reset acknowledgement (never needed by test:integration):
# RESET_TEST_DATABASE=yes
# NODE_ENV is set by Next.js/tests; production NODE_ENV or APP_ENV forbids test/reset/env generation.
# JOBFLOW_ISOLATED_TEST_DATABASE is injected by the integration runner; do not set manually.
